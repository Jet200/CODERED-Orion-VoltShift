# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELECTRICITY_MAPS_KEY: API Key for Electricity Maps v3 real-time grid carbon intensity.
ELECTRICITY_MAPS_KEY="YOUR_ELECTRICITY_MAPS_KEY"

# EIA_API_KEY: US Energy Information Administration (EIA v2) API Key.
EIA_API_KEY="YOUR_EIA_API_KEY"

# NREL_API_KEY: National Renewable Energy Laboratory (NREL / NLR) API Key.
NREL_API_KEY="YOUR_NREL_API_KEY"

# VITE_MAPBOX_TOKEN: Mapbox public access token for 3D vector basemap (optional; falls back to vector view if omitted).
VITE_MAPBOX_TOKEN="YOUR_MAPBOX_ACCESS_TOKEN"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
